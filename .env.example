# AstraBill — environment variables
# Copy to .env.local and fill in. Never commit the filled file (see .gitignore).

# --- Database (Supabase Postgres, used as a plain DB only) ---
# Use the connection-pooler URL (port 6543) for the app runtime.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres"

# --- Auth (NextAuth v5 / AuthJS) ---
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""                    # Google OAuth — fallback login provider
AUTH_GOOGLE_SECRET=""

# --- Redis (OTP storage + BullMQ WhatsApp queue) ---
REDIS_URL="redis://localhost:6379"

# --- Razorpay (Smart Collect + Payment Links) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- WhatsApp (Meta Cloud API — Opryon Labs WABA) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- Supabase Storage (PDFs, logos) ---
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- PDF microservice (Puppeteer on Digital Ocean) ---
PDF_SERVICE_URL=""
PDF_SERVICE_TOKEN=""

# --- Error alerting ---
SENTRY_DSN=""

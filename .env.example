# AstraBill — environment variables
# Copy to .env.local and fill in. Never commit the filled file (see .gitignore).

# --- Database (Supabase Postgres, used as a plain DB only) ---
# DATABASE_URL: app runtime → transaction pooler (port 6543, pgbouncer=true).
# DIRECT_DATABASE_URL: drizzle-kit migrations → session pooler (port 5432).
# URL-encode special chars in the password: # → %23, @ → %40, : → %3A, / → %2F.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- Auth (NextAuth v5 / AuthJS) ---
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""                    # Google OAuth — one of the two entry doors
AUTH_GOOGLE_SECRET=""

# --- Redis ---
# Serverless OTP + rate-limit storage (Vercel-friendly REST client).
# Get from console.upstash.com → create a Redis DB → "REST API" tab.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# TCP Redis URL for the BullMQ WhatsApp send queue on the Digital Ocean worker
# (Upstash also exposes a TCP endpoint — same DB, different protocol).
REDIS_URL="redis://localhost:6379"

# --- Razorpay (Smart Collect + Payment Links) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- WhatsApp (Meta Cloud API — Opryon Labs WABA) ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# --- Cloudinary (file storage — invoice PDFs, logos, customer images) ---
# Sign up at cloudinary.com → Dashboard → API Keys. Free tier is plenty for V1.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Loops.so (transactional email) ---
# Authenticate domain astrabill.com once (SPF + DKIM + DMARC DNS records).
# FROM address is `hello@astrabill.com` (display "AstraBill"), set inside Loops.
LOOPS_API_KEY=""

# --- PDF microservice (Puppeteer on Digital Ocean) ---
PDF_SERVICE_URL=""
PDF_SERVICE_TOKEN=""

# --- Error alerting ---
SENTRY_DSN=""

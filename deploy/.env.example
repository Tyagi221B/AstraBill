# Droplet stack env. Copy this to `.env` (sibling of docker-compose.yml) on
# the droplet and fill in real values. NEVER COMMIT a real `.env` — the
# repo .gitignore already covers it; double-check before `git add -A`.
#
# Generate the token with:
#   openssl rand -hex 32
#
# The same value goes into Vercel's env as PDF_SERVICE_TOKEN — both sides
# of the wire need to know it.

PDF_SERVICE_TOKEN=
